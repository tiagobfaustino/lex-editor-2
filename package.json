{
  "name": "lex-editor",
  "version": "0.1.0",
  "private": true,
  "description": "Editor desktop para transformação e publicação segura de conteúdo legislativo.",
  "type": "module",
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=22.15.0",
    "npm": ">=10.9.0"
  },
  "packageManager": "npm@10.9.2",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "electron-vite dev",
    "build:app": "electron-vite build",
    "build:workspaces": "npm run build --workspaces --if-present",
    "postinstall": "install-electron",
    "preview": "electron-vite preview",
    "prepare": "node scripts/configure-git-hooks.mjs",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "npm run lint -- --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "check:pre-commit": "npm run lint && npm run format:check",
    "test": "npm run test:unit",
    "test:boundaries": "node tests/config/eslint-boundaries.test.mjs",
    "check:data-model": "node scripts/audit-data-model.mjs",
    "test:unit": "vitest run",
    "typecheck": "npm run typecheck:workspaces && npm run typecheck:node && npm run typecheck:renderer",
    "typecheck:workspaces": "npm run typecheck --workspaces --if-present",
    "typecheck:node": "tsc --project tsconfig.node.json --noEmit",
    "typecheck:renderer": "tsc --project tsconfig.renderer.json --noEmit",
    "test:e2e": "npm run build:app && playwright test",
    "test:e2e:only": "playwright test",
    "build": "npm run build:workspaces && npm run build:app && electron-builder --config electron-builder.yml",
    "build:unpacked": "npm run build:app && electron-builder --config electron-builder.yml --dir"
  },
  "devDependencies": {
    "@electron/asar": "3.4.1",
    "@electron/fuses": "1.8.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@swc/core": "1.15.47",
    "@types/node": "22.20.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "electron": "43.2.0",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "eslint": "10.8.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "globals": "17.8.0",
    "prettier": "3.9.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "typescript": "6.0.2",
    "typescript-eslint": "8.65.0",
    "vite": "7.3.6",
    "vitest": "4.1.10"
  },
  "dependencies": {
    "zod": "4.4.3"
  }
}
