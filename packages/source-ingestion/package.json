{
  "name": "@lex-editor/source-ingestion",
  "version": "0.1.0",
  "private": true,
  "description": "Contratos puros de configuração e ingestão de fontes oficiais.",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node/index.d.ts",
      "import": "./dist/node/index.js"
    }
  },
  "scripts": {
    "build": "tsc --build tsconfig.json",
    "typecheck": "tsc --project tsconfig.json --noEmit"
  },
  "dependencies": {
    "@lex-editor/legal-domain": "0.1.0",
    "defuddle": "0.19.2",
    "zod": "4.4.3"
  }
}
