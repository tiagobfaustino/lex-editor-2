      "types": "./dist/main.d.ts",
      "import": "./dist/main.js"
    }
  },
  "scripts": {
    "build": "tsc --build tsconfig.json",
    "typecheck": "tsc --build tsconfig.json"
  },
  "dependencies": {
    "@lex-editor/legal-domain": "0.1.0"
  }
}
